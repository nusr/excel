{
  "name": "excel",
  "version": "0.0.1",
  "private": true,
  "description": "Online Collaboration Excel",
  "author": "Steve Xu <stevexugc@gmail.com>",
  "bugs": "https://github.com/nusr/excel/issues",
  "homepage": "https://github.com/nusr/excel",
  "repository": "git+https://github.com/nusr/excel.git",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/demo/*"
  ],
  "scripts": {
    "start": "lerna run start",
    "type-check": "tsc --noEmit -p tsconfig.node.json && lerna run type-check",
    "build": "lerna run build",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "coverage": "yarn test:ci --coverage",
    "lint": "npx oxlint@latest",
    "lint:fix": "npx oxlint@latest --fix",
    "prepare": "husky && npm run build",
    "install-font": "mkdir -p \"$HOME/.fonts\" && cp ./scripts/SourceCodePro-VariableFont_wght.ttf \"$HOME/.fonts/\" && fc-cache -fv \"$HOME/.fonts\"",
    "release:major": "lerna version major --conventional-commits --no-private --no-push --yes --no-git-tag-version",
    "release:minor": "lerna version minor --conventional-commits --no-private --no-push --yes --no-git-tag-version",
    "release:patch": "lerna version patch --conventional-commits --no-private --no-push --yes --no-git-tag-version",
    "e2e": "playwright test",
    "e2e:prod": "TEST_ENV=production npx playwright test",
    "e2e:preview": "TEST_ENV=preview playwright test --project=chromium",
    "e2e:ui": "npm run e2e -- --ui",
    "start:e2e": "lerna run start:e2e --scope=frontend",
    "check:dependencies": "check-dependency-version-consistency . --dep-type=dependencies,devDependencies"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "canvas": "^3.2.3",
    "check-dependency-version-consistency": "^6.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lerna": "^10.1.1",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "yjs": "^13.6.33"
  },
  "packageManager": "yarn@1.22.22"
}
