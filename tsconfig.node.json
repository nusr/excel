{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    "vitest.config.ts",
    "scripts/vitest.config.ts",
    "packages/**/vite*.config.mts",
    "packages/**/package.json",
    "packages/**/vitest.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
