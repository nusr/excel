{
  "name": "excel-collab",
  "version": "0.1.13",
  "description": "Online Collaboration Excel",
  "keywords": [
    "collaboration",
    "excel",
    "react",
    "spreadsheet",
    "xlsx",
    "yjs"
  ],
  "homepage": "https://github.com/nusr/excel",
  "bugs": "https://github.com/nusr/excel/issues",
  "license": "MIT",
  "author": "Steve Xu <stevexugc@gmail.com>",
  "repository": "git+https://github.com/nusr/excel.git",
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md",
    "package.json"
  ],
  "main": "./lib/index.umd.js",
  "module": "./lib/index.es.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "protocol": [
        "lib/protocol.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.es.js",
      "module": "./lib/index.es.js",
      "require": "./lib/index.umd.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "import": "./lib/protocol.mjs",
      "require": "./lib/protocol.cjs"
    },
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc",
    "build": "vite build && vite build --config vite.protocol.config.mts",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-report.junit.xml"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "chart.js": "^4.5.1",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.17",
    "excelize-wasm": "^0.1.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.59.0",
    "numfmt": "^4.0.1",
    "react-aria-components": "^1.22.1",
    "uuid": "^14.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "yjs": "^13.6.32"
  }
}
